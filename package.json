{
  "homepage": "/",
  "name": "tmht-checkin-system",
  "type": "module",
  "version": "1.0.5",
  "description": "TMHT Check-in and Data Management System",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "deploy:verify": "node scripts/verify-production-deploy.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest --run --environment jsdom --maxWorkers=4 --minWorkers=1",
    "test:poc": "vitest --run --environment jsdom src/experiments/rxdb-backend-poc/rxdb-poc.test.js",
    "test:poc:integration": "pwsh -NoProfile -File scripts/local/apply-rxdb-poc-fixtures.ps1 && vitest --run src/experiments/rxdb-backend-poc/localSupabase.integration.test.js",
    "test:poc:browser": "playwright test --config playwright.rxdb-poc.config.js",
    "build:poc": "vite build --config vite.rxdb-poc.config.js",
    "build:member-v2": "vite build --config vite.rxdb-member-phase1.config.js",
    "build:member-v2:android-test": "vite build --config vite.member-v2-android-test.config.js --mode member-v2-android-test",
    "test:member-v2": "vitest --run --environment jsdom src/services/member-v2/MemberService.test.js src/services/member-v2/MemberAttendanceService.test.js src/experiments/rxdb-member-phase1/main.test.jsx && vitest --run src/services/member-v2/MemberService.localSupabase.integration.test.js",
    "test:member-v2:browser": "playwright test --config playwright.rxdb-member-phase1.config.js",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:smoke:prod": "npm run build && node scripts/run-playwright-preview.mjs",
    "test:service-simulation": "vitest run src/utils/serviceSimulation.test.js src/utils/offlineStore.test.js src/utils/realtimeMerge.test.js && playwright test tests/service-simulation.spec.js",
    "test:preflight": "npm run build && npm run test && npm run test:smoke",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "android:sync": "npm run build && cap sync android",
    "android:sync:local": "set CAPACITOR_LOCAL_BUNDLE=true&& npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "node scripts/build-android-apk.mjs debug",
    "android:apk:local": "node scripts/build-android-apk.mjs debug --local",
    "android:member-v2-test": "node scripts/build-member-v2-android-validation.mjs",
    "android:apk:release": "node scripts/build-android-apk.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@google/genai": "^2.16.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "^1.4.0",
    "@supabase/supabase-js": "^2.38.0",
    "@zxing/browser": "^0.2.0",
    "csv-stringify": "^6.4.4",
    "file-saver": "^2.0.5",
    "lodash": "^4.17.23",
    "lucide-react": "^0.294.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "7.88.0",
    "react-rnd": "^10.5.2",
    "react-toastify": "^9.1.3",
    "rxdb": "17.5.0",
    "rxjs": "7.8.2",
    "web-haptics": "^0.0.6",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "fake-indexeddb": "6.2.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.31",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^6.0.3",
    "vite": "^4.5.0",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "react",
    "supabase",
    "checkin",
    "attendance",
    "church"
  ],
  "author": "TMHT",
  "license": "MIT"
}
